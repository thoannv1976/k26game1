# API (apps/api) – copy to apps/api/.env for local runs, or set as Cloud Run env vars.
# No secret API keys are needed: Google APIs use the Cloud Run service account (ADC).
NODE_ENV=development
PORT=8080
GCP_PROJECT_ID=k26game1

# Providers: vertex|fake, google|fake, google|fake, gcs|local|memory.
# "fake"/"local" are for local development and tests only – the API refuses them when NODE_ENV=production.
AI_PROVIDER=fake
SPEECH_PROVIDER=fake
TTS_PROVIDER=fake
BLOB_STORE=local
LOCAL_DATA_DIR=.data

# Vertex AI / Gemini
VERTEX_LOCATION=asia-southeast1
# Overrides the model configured per school (Admin → AI). Use a Flash model available in your region.
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2

# Speech-to-Text
STT_MODEL=latest_long
STT_LANGUAGE=en-US

# Cloud Storage bucket for student audio + TTS cache
AUDIO_BUCKET=k26game1-audio

# Local emulators (set automatically by "firebase emulators:exec")
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# D4: service accounts allowed to read learner evidence (VSTEP Quest four-skill profile); audience of their ID tokens
LMS_SERVICE_ACCOUNTS=
LMS_SERVICE_AUDIENCE=k26-lms
# UniGame Hub (LTI 1.3 SSO + Moodle grade sync). Off by default.
LTI_ENABLED=false
LTI_HUB_URL=https://unigame-hub-423573033950.asia-southeast1.run.app
LTI_GAME_ID=k26game1
# Hub tenant -> this app's tenant, "hubTenant=appTenant;other=x"
LTI_TENANT_MAP=
# From Secret Manager in production (secret: unigamehub-secret)
LTI_GAME_SECRET=

# Extra blocked words for the content filter (comma separated)
BLOCKED_TERMS=
LOG_LEVEL=debug
